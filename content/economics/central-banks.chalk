cite#rba-cash-rate(
    authors: Reserve Bank of Australia
    year: n.d.
    title: Cash rate target
    publisher: Reserve Bank of Australia
    url: https://www.rba.gov.au/statistics/cash-rate/
)
cite#abs-cpi(
    authors: Australian Bureau of Statistics
    year: n.d.
